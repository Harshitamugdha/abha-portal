# Copy to .env. Never commit .env.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser. Secrets never get that prefix (TRAPS §9).

# --- Database (Prisma 7 reads this via prisma.config.ts + dotenv) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/abha_portal"

# --- Sessions ---
JWT_SECRET="replace-with-32+-random-characters"
SESSION_HOURS=8

# --- ABHA provider (D1) ---
ABHA_PROVIDER="mock"            # only "mock" exists; the interface allows a real one later
ABHA_DEV_OTP="123456"           # the mock's OTP for every patient (no SMS exists); shown as a hint only in development

# --- Files ---
FILE_STORAGE_DIR="./.uploads"   # outside public/ (TRAPS §12)
FILE_MAX_BYTES=5242880

# --- Stub phase only (Master §8.3). Delete before the integration gate. ---
# DEV_FAKE_USER="asha"           # asha | kavya | arjun | lab | pharmacy | admin
