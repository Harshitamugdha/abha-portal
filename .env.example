# Copy to .env. Never commit .env.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser. Secrets never get that prefix (TRAPS §9).

# --- Database (Prisma 7 reads this via prisma.config.ts + dotenv) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/abha_portal"
DIRECT_URL=""                   # optional: Prisma CLI (migrate, seed) uses this if set. On Neon: the non-pooled string; DATABASE_URL = pooled

# --- Sessions ---
JWT_SECRET="replace-with-32+-random-characters"
SESSION_HOURS=8

# --- ABHA provider (D1) ---
ABHA_PROVIDER="mock"            # only "mock" exists; the interface allows a real one later
ABHA_DEV_OTP="123456"           # OTP for patients with no email (or when email is off); shown as a hint only in development

# --- OTP by email (optional). Without RESEND_API_KEY every patient uses ABHA_DEV_OTP ---
RESEND_API_KEY=""               # from resend.com; secret, never NEXT_PUBLIC_
OTP_EMAIL_FROM=""               # optional; default "ABHA Health Portal <onboarding@resend.dev>"
DEMO_PATIENT_EMAIL=""           # read by the seed: Asha's email. On Resend's free tier use the email you signed up with

# --- Files ---
FILE_MAX_BYTES=5242880
