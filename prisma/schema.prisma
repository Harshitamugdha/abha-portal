generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  PHARMACY
  LAB
  ADMIN
}

enum InstitutionType {
  HOSPITAL
  PHARMACY
  LAB
}

enum RecordType {
  ENCOUNTER
  PRESCRIPTION
  LAB_REPORT
  DOCUMENT
}

enum ConsentStatus {
  REQUESTED
  GRANTED
  DENIED
  REVOKED
}

enum LabOrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum AuditOutcome {
  ALLOWED
  DENIED
}

model User {
  id           String   @id @default(cuid())
  role         Role
  name         String
  email        String?  @unique
  passwordHash String?
  hprId        String?
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())

  abha        AbhaProfile?
  memberships Membership[]

  recordsAsPatient   HealthRecord[] @relation("RecordPatient")
  recordsAuthored    HealthRecord[] @relation("RecordAuthor")
  labOrdersAsPatient LabOrder[]     @relation("LabOrderPatient")
  labOrdersOrdered   LabOrder[]     @relation("LabOrderDoctor")
  consentsAsPatient  ConsentGrant[] @relation("ConsentPatient")
  consentsAsDoctor   ConsentGrant[] @relation("ConsentDoctor")
}

model AbhaProfile {
  userId      String   @id
  abhaNumber  String   @unique
  abhaAddress String   @unique
  mobileLast4 String
  email       String?
  dob         DateTime
  gender      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Institution {
  id   String          @id
  name String
  type InstitutionType
  city String

  memberships Membership[]
  records     HealthRecord[]
  labOrders   LabOrder[]
  consents    ConsentGrant[]
}

model Membership {
  userId        String
  institutionId String

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id])

  @@id([userId, institutionId])
}

model HealthRecord {
  id            String     @id @default(cuid())
  patientId     String
  institutionId String
  authorId      String?
  type          RecordType
  title         String
  summary       String?
  occurredAt    DateTime
  fileId        String?    @unique
  createdAt     DateTime   @default(now())

  patient      User          @relation("RecordPatient", fields: [patientId], references: [id])
  institution  Institution   @relation(fields: [institutionId], references: [id])
  author       User?         @relation("RecordAuthor", fields: [authorId], references: [id])
  file         FileObject?   @relation(fields: [fileId], references: [id])
  prescription Prescription?
  labOrder     LabOrder?     @relation("LabOrderResult")

  @@index([patientId, type, occurredAt])
}

model Prescription {
  recordId    String    @id
  items       Json
  shareCode   String    @unique
  dispensedAt DateTime?
  dispensedBy String?
  expiresAt   DateTime

  record HealthRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model LabOrder {
  id               String         @id @default(cuid())
  patientId        String
  orderedById      String
  labInstitutionId String
  tests            String[]
  status           LabOrderStatus @default(PENDING)
  resultRecordId   String?        @unique
  createdAt        DateTime       @default(now())

  patient        User          @relation("LabOrderPatient", fields: [patientId], references: [id])
  orderedBy      User          @relation("LabOrderDoctor", fields: [orderedById], references: [id])
  labInstitution Institution   @relation(fields: [labInstitutionId], references: [id])
  resultRecord   HealthRecord? @relation("LabOrderResult", fields: [resultRecordId], references: [id])
}

model ConsentGrant {
  id            String        @id @default(cuid())
  patientId     String
  doctorId      String
  institutionId String
  scopes        RecordType[]
  purpose       String
  durationDays  Int           @default(7)
  status        ConsentStatus @default(REQUESTED)
  requestedAt   DateTime      @default(now())
  decidedAt     DateTime?
  validFrom     DateTime?
  validTo       DateTime?

  patient     User        @relation("ConsentPatient", fields: [patientId], references: [id])
  doctor      User        @relation("ConsentDoctor", fields: [doctorId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])

  @@index([patientId, doctorId, status])
}

model AuditLog {
  id           String       @id @default(cuid())
  at           DateTime     @default(now())
  actorId      String
  actorRole    Role
  action       String
  resourceType String
  resourceId   String?
  patientId    String?
  consentId    String?
  outcome      AuditOutcome
  reason       String?

  @@index([patientId, at])
}

model FileObject {
  id         String   @id @default(cuid())
  key        String
  mimeType   String
  sizeBytes  Int
  uploadedBy String
  createdAt  DateTime @default(now())

  record HealthRecord?
}

model OtpTransaction {
  id            String    @id
  rateKey       String
  abhaNumber    String?
  otpHash       String
  expiresAt     DateTime
  wrongAttempts Int       @default(0)
  usedAt        DateTime?
  createdAt     DateTime

  @@index([rateKey, createdAt])
}
